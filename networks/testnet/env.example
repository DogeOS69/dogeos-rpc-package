# DogeOS RPC package settings for testnet.
#
# Copy to .env in the repository root, fill in DATA_ROOT, and keep it private:
#   cp networks/testnet/env.example .env && chmod 600 .env
# Docker Compose and the scripts read .env automatically. This is the only file
# you edit; everything under networks/testnet/ is maintained by the package.

NETWORK=testnet

# --- Required ----------------------------------------------------------------

# Absolute path on this host's data disk for L2Reth and L1 Interface data and
# snapshot downloads. Not inside this repository. Check that the disk is
# mounted (for example: findmnt -T /data).
DATA_ROOT=/path/to/dogeos-data/testnet

# --- Keep unchanged after the first start ------------------------------------

# Compose project and Dogecoin Docker volume. These match earlier releases;
# a node that used custom names keeps its own. Changing them later starts new
# containers and an empty Dogecoin volume.
COMPOSE_PROJECT_NAME=dogeos-rpc-package
DOGECOIN_VOLUME_NAME=dogeos-rpc-package_dogecoin_data

# Dogecoin RPC credentials, passed to dogecoin-node and l1-interface as Docker
# secrets. These are the earlier package's public defaults; change them once
# if you like (letters, digits, and ._~:@%+=,- only) and never expose the
# Dogecoin RPC port with them.
DOGECOIN_RPC_USER=doge
DOGECOIN_RPC_PASSWORD=password

# --- Optional (defaults shown) -----------------------------------------------

# Host ports.
# DOGECOIN_P2P_PORT=44556
# DOGECOIN_RPC_PORT=44555
# L2_HTTP_PORT=8545
# L2_WS_PORT=8546
# L2_P2P_PORT=30303
# L2_METRICS_PORT=6060        # Prometheus, always on 127.0.0.1

# Interface for the Dogecoin RPC and L1 Interface ports (8547, 5052, 9090),
# which only this stack and local checks need. Unset publishes them on all
# interfaces, as earlier releases did; 127.0.0.1 is recommended.
# INTERNAL_BIND_ADDR=127.0.0.1

# Ethereum Sepolia execution RPC used by L1 Interface. The provider must allow
# chain ID 11155111 and eth_getBlockByHash.
# ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Temporary use of an external Dogecoin RPC instead of the bundled node (see
# docs/operations.md before switching).
# EXTERNAL_DOGECOIN_RPC_URL=https://your-dogecoin-rpc
# EXTERNAL_DOGECOIN_RPC_USER=
# EXTERNAL_DOGECOIN_RPC_PASSWORD=

# L2Reth RPC. debug and trace are on; filter and rate-limit them in your
# gateway. Extra rollup-node flags are separated by spaces and must not repeat
# flags the package already sets (for example --rpc.max-connections).
# L2RETH_HTTP_API=eth,net,web3,debug,trace
# L2RETH_WS_API=eth,net,web3,debug,trace
# L2RETH_EXTRA_ARGS=--rpc.max-tracing-requests 8

# Memory (tuned for a 64 GB host) and log rotation.
# DOGECOIN_MEM_RESERVATION=14g
# DOGECOIN_MEM_LIMIT=24g
# L2RETH_MEM_LIMIT=8g
# L1_INTERFACE_MEM_LIMIT=2g
# LOG_MAX_SIZE=100m
# LOG_MAX_FILE=5
