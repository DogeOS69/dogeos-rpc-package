# L2Reth settings for testnet, read by scripts/l2reth_entrypoint.sh.

# L1 Interface JSON-RPC used as L2Reth's L1 endpoint.
L2RETH_L1_ENDPOINT=http://l1-interface:8545

# Trusted testnet peers (enode URLs).
L2RETH_PEER_LIST=["enode://49a8ef3983f09b5b27290b05e64cef28118b0e8d4ffdfdd14e879eefb09d7c52cb7a2852d20d5efebbe3686dc17b556fbeece0e477410871ed9c0a8e88538202@dogeos-testnet-cluster-b-0-68dc9c36e8602723.elb.us-west-2.amazonaws.com:30303","enode://f2a711244864c40960df41b626f6d9108a45c06026e0453287f419cb4c0c7445449bfe61d3149ccc9f0440288cd7b7a1d06854b12ab4a76b614a0392755d07c3@dogeos-testnet-cluster-b-1-cc9a2ccd7b707a6b.elb.us-west-2.amazonaws.com:30303","enode://90b1d52f52cfd40d9431594601393da6dd083d3ea133d2cecb0e9788371c753f6893512033a8854cd0f11a15df014d6d63007d3381c442d124994becef5fdf04@dogeos-testnet-cluster-b-reth-0-5c7f5d78956842a9.elb.us-west-2.amazonaws.com:30303","enode://af14dff4906df5b0de6182237aca4b244ae8356e7210ed73374a61cce13b838cb99633b7060386fec1e6ec33c54d8bf349b5b8ae34d976ab8c447e37e5a0c0d6@dogeos-testnet-cluster-b-reth-1-61b7ec1e88012c49.elb.us-west-2.amazonaws.com:30303"]

# P2P network ID of the testnet nodes (not the chain ID); peers with a
# different ID are dropped during the handshake.
L2RETH_NETWORK_ID=6281971

# DA blob archive that L2Reth reads directly.
L2RETH_BLOB_S3_URL=https://dogeos-eth-da-archive-testnet.s3.us-west-2.amazonaws.com/batches
