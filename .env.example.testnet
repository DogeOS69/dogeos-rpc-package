# Network Selection
# L1 Interface uses the public Sepolia RPC from envs/testnet/l1-interface.env by
# default. Copy l1-interface.local.env.example only when overriding that RPC.
# Dogecoin credentials are chosen below and shared with both services through
# Docker secrets.
NETWORK=testnet

# Docker Compose Project Name
# Used to isolate containers and networks when multiple environments run on one host.
# Keep the pre-v0.3.0 default for upgrades. If your old deployment used a custom
# project name, keep that name here and its matching DOGECOIN_VOLUME_NAME below.
COMPOSE_PROJECT_NAME=dogeos-rpc-package

# Persistent Data Directory (L2Reth and L1 Interface data)
# REQUIRED: replace this placeholder with an absolute path on this host's data disk.
# /path/to/... is a placeholder, not a usable default. Edit it before any commands.
# For upgrades, choose a fresh path for L2Reth and L1 Interface data.
# Verify the disk is mounted. Do not put chain data under this repository.
DATA_ROOT=/path/to/dogeos-data/testnet

# Dogecoin Docker Volume
# Dogecoin data stays in a named Docker volume so nodes upgraded from earlier
# releases keep their chain data without a resync. The default matches the
# volume name created by pre-v0.3.0 releases (COMPOSE_PROJECT_NAME was
# "dogeos-rpc-package" on testnet). If you used a custom COMPOSE_PROJECT_NAME
# before, set this to "<your-old-project-name>_dogecoin_data".
# Check with: docker volume ls | grep dogecoin_data
# Testnet leaves DOGECOIN_DATA unset so existing nodes keep this volume.
DOGECOIN_VOLUME_NAME=dogeos-rpc-package_dogecoin_data

# Dogecoin RPC Credentials
# These compatibility defaults match the earlier testnet package. Change them
# here once if desired and keep them stable. Compose mounts the same values as
# secrets into both dogecoin-node and l1-interface. They are never generated or
# changed automatically. Never expose the RPC port publicly with this password.
DOGECOIN_RPC_USER=doge
DOGECOIN_RPC_PASSWORD=password

# Dogecoin Ports
DOGECOIN_P2P_PORT=44556
DOGECOIN_RPC_PORT=44555

# L2Reth Ports
L2_HTTP_PORT=8545
L2_WS_PORT=8546
L2_P2P_PORT=30303

# Internal RPC Ports
# Dogecoin RPC and L1 Interface ports (8547, 5052, 9090) are only needed by this
# stack and local checks. Leave empty to keep publishing them on all interfaces
# as earlier testnet releases did, or set 127.0.0.1 to restrict them to this host.
# INTERNAL_BIND_ADDR=127.0.0.1

# L2Reth RPC (optional - uncomment to override)
# debug and trace are enabled by default. Filter and rate-limit them in your
# RPC gateway; trace calls are memory- and CPU-intensive.
# L2RETH_HTTP_API=eth,net,web3,debug,trace
# L2RETH_WS_API=eth,net,web3,debug,trace
# Extra rollup-node flags, separated by spaces. Do not repeat flags that
# scripts/l2reth_entrypoint.sh already sets (for example --rpc.max-connections).
# L2RETH_EXTRA_ARGS=--rpc.max-tracing-requests 8

# L2Reth Prometheus metrics, published on 127.0.0.1 only.
# L2_METRICS_PORT=6060

# Container log rotation (json-file driver).
# LOG_MAX_SIZE=100m
# LOG_MAX_FILE=5

# Dogecoin Memory Reservation
DOGECOIN_MEM_RESERVATION=14g

# Memory Limits (optional - uncomment to override defaults in docker-compose.yml)
# Adjust based on your host memory and expected RPC traffic.
# DOGECOIN_MEM_LIMIT=24g
# L2RETH_MEM_LIMIT=8g
# L1_INTERFACE_MEM_LIMIT=2g
