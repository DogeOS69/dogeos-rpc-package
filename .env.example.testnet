# Network Selection
# L1 Interface uses the public Sepolia RPC from envs/testnet/l1-interface.env by
# default. Copy l1-interface.local.env.example only when overriding that RPC.
# Dogecoin credentials are chosen below and shared with both services through
# Docker secrets.
NETWORK=testnet

# Docker Compose Project Name
# Used to isolate containers and networks when multiple environments run on one host.
COMPOSE_PROJECT_NAME=dogeos-testnet

# Persistent Data Directory (L2Reth and L1 Interface data)
# This example assumes a dedicated data disk is mounted at /data. Change it for
# the host before starting. Do not put chain data under this repository.
DATA_ROOT=/data/dogeos-data/testnet

# Dogecoin Docker Volume
# Dogecoin data stays in a named Docker volume so nodes upgraded from earlier
# releases keep their chain data without a resync. The default matches the
# volume name created by pre-v0.3.0 releases (COMPOSE_PROJECT_NAME was
# "dogeos-rpc-package" on testnet). If you used a custom COMPOSE_PROJECT_NAME
# before, set this to "<your-old-project-name>_dogecoin_data".
# Check with: docker volume ls | grep dogecoin_data
DOGECOIN_VOLUME_NAME=dogeos-rpc-package_dogecoin_data

# Dogecoin RPC Credentials
# These compatibility defaults match the earlier testnet package. Change them
# here once if desired and keep them stable. Compose mounts the same values as
# secrets into both dogecoin-node and l1-interface. They are never generated or
# changed automatically. Never expose the RPC port publicly with this password.
DOGECOIN_RPC_USER=doge
DOGECOIN_RPC_PASSWORD=password

# Dogecoin Ports
DOGECOIN_P2P_PORT=44556
DOGECOIN_RPC_PORT=44555

# L2Reth Ports
L2_HTTP_PORT=8545
L2_WS_PORT=8546
L2_P2P_PORT=30303

# Dogecoin Memory Reservation
DOGECOIN_MEM_RESERVATION=14g

# Memory Limits (optional - uncomment to override defaults in docker-compose.yml)
# Adjust based on your host memory and expected RPC traffic.
# DOGECOIN_MEM_LIMIT=20g
# L2RETH_MEM_LIMIT=8g
# L1_INTERFACE_MEM_LIMIT=2g
