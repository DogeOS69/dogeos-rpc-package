# L1 Interface Mainnet Configuration
#
# Mainnet is private. This file follows the current testnet layout
# (envs/testnet/l1-interface.env, generated by `scrollsdk setup gen-rpc-package`).
# The empty values below are not public yet: operators receive them at
# onboarding and set them in envs/mainnet/l1-interface.local.env (gitignored,
# loaded after this file). Fill in every empty value before starting.
#
# The deposit gas limit (message_queue_gas_limit = 200,000) and the chain ids
# now come from configs/mainnet/protocol_context.json and
# configs/mainnet/l2reth-genesis.json.
# The old SCROLL_MESSENGER_ADDRESS, L2_MOAT_CONTRACT_ADDRESS and
# INITIAL_SYSTEM_SIGNER variables are rejected at startup by the current
# l1-interface, and DEPOSIT_GAS_LIMIT is no longer read.

RUST_LOG=info
# The Dogecoin library names Dogecoin mainnet `bitcoin`; `mainnet` is rejected.
DOGEOS_L1_INTERFACE_NETWORK_STR=bitcoin
DOGEOS_L1_INTERFACE_DATABASE_URL=sqlite:///data/l1-interface.sqlite
DOGEOS_L1_INTERFACE_API_BIND_ADDRESS=0.0.0.0:8545
DOGEOS_L1_INTERFACE_BEACON_API_LISTEN_ADDRESS=0.0.0.0:5052
DOGEOS_L1_INTERFACE_HEALTH_LISTEN_ADDRESS=0.0.0.0:9090
DOGEOS_L1_INTERFACE_L1_GAS_LIMIT=30000000
DOGEOS_L1_INTERFACE_L1_BASE_FEE_PER_GAS=100000000
DOGEOS_L1_INTERFACE_GENESIS_JSON_PATH=/app/genesis/genesis.json
DOGEOS_L1_INTERFACE_SEQUENCER_GENESIS_MODE=false

# Provided at onboarding: Dogecoin start heights.
DOGEOS_L1_INTERFACE_L1_GENESIS_BLOCK=
DOGEOS_L1_INTERFACE_DOGECOIN_INDEXER__START_HEIGHT=

# Provided at onboarding: Dogecoin confirmation depth.
DOGEOS_L1_INTERFACE_DOGECOIN_INDEXER__CONFIRMATIONS=
DOGEOS_L1_INTERFACE_DOGECOIN_INDEXER__INDEX_UTXOS=false
DOGEOS_L1_INTERFACE_DOGECOIN_INDEXER__INDEX_DEPOSITS=true
DOGEOS_L1_INTERFACE_DOGECOIN_INDEXER__POLL_INTERVAL_MS=10000

# Provided at onboarding: Bridge, fee wallet and sequencer Dogecoin addresses.
DOGEOS_L1_INTERFACE_DOGECOIN_INDEXER__BRIDGE_ADDRESS=
DOGEOS_L1_INTERFACE_DOGECOIN_INDEXER__FEE_WALLET_ADDRESS=
DOGEOS_L1_INTERFACE_DOGECOIN_INDEXER__SEQUENCER_ADDRESS=

# Your own Ethereum mainnet execution RPC, and the DA blob archive URL
# (provided at onboarding).
DOGEOS_L1_INTERFACE_ETHEREUM_DA__L1_RPC_URL=
DOGEOS_L1_INTERFACE_ETHEREUM_DA__BLOB_SOURCE__TIMEOUT_MS=10000
DOGEOS_L1_INTERFACE_ETHEREUM_DA__BLOB_SOURCE__AWS_S3__URL=
DOGEOS_L1_INTERFACE_ETHEREUM_DA__BLOB_SOURCE__AWS_S3__KEY_PREFIX=batches

# The public RPC requires the protocol context.
DOGEOS_L1_INTERFACE_REPLAY_READ__ENABLED=true
DOGEOS_L1_INTERFACE_REPLAY_READ__SQLITE_PATH=/data/replay.sqlite
DOGEOS_L1_INTERFACE_REPLAY_READ__PROTOCOL_CONTEXT_JSON=/app/protocol_context.json

# Provided at onboarding if mainnet needs them: the remaining replay-read and
# event-plane settings. Testnet sets:
#   DOGEOS_L1_INTERFACE_REPLAY_READ__MAINTAINER_ENABLED=true
#   DOGEOS_L1_INTERFACE_REPLAY_READ__REQUIRE_FULL_VALIDATION=false
#   DOGEOS_L1_INTERFACE_REPLAY_READ__L2_BOOTSTRAP_NEXT_STARTING_BLOCK_HEIGHT=...
#   DOGEOS_L1_INTERFACE_EVENT_PLANE_ARTIFACT_PATH=/data/l1-interface-historical-artifact.sqlite
#   DOGEOS_L1_INTERFACE_EVENT_PLANE_GENESIS_BOUNDARY=...
#   DOGEOS_L1_INTERFACE_REPLAY_READ__P2PKH_VERSIONED_ENVELOPE_START_WITHDRAW_INDEX=...
