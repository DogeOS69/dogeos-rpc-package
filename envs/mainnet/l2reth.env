# L2Reth Mainnet Configuration
#
# DRAFT: mainnet is not launched. Empty values below are TODO(mainnet) and
# make the entrypoint fail fast until they are filled in.
# Chain id 1122005 comes from configs/mainnet/l2reth-genesis.json.

L2RETH_L1_ENDPOINT=http://l1-interface:8545

# TODO(mainnet): confirm the P2P network id used by the mainnet cluster nodes.
L2RETH_NETWORK_ID=

# TODO(mainnet): confirm the public DA blob archive URL.
L2RETH_BLOB_S3_URL=

# TODO(mainnet): public bootnode/sequencer enodes.
L2RETH_PEER_LIST=

# TODO(mainnet): confirm the authorized sequencer signer address.
L2RETH_VALID_SIGNER=

# Providers forward eth_sendRawTransaction to the sequencer with
# --network.sequencer-url. TODO(mainnet): confirm the public sequencer RPC URL.
L2RETH_SEQUENCER_URL=

# Matches numL1MessagesPerBlock in the mainnet genesis.
L2RETH_MAX_L1_MESSAGES=10

# The legacy geth header transform is testnet-only and rejected on mainnet.
L2RETH_LEGACY_GETH_HEADER_TRANSFORM=false

# --gpo.maxprice must be at least the 420,000 DOGE-gwei base fee cap so
# eth_maxPriorityFeePerGas is not capped at reth's 500 gwei default.
# TODO(mainnet): confirm the value.
L2RETH_GPO_MAXPRICE=420000000000000
