# L2Reth Mainnet Configuration
#
# Mainnet is private. The empty values below are not public yet: operators
# receive them at onboarding and set them in envs/mainnet/l2reth.local.env
# (gitignored, loaded after this file). Until then the entrypoint stops with
# "must be set".
# Chain id 1122005 comes from configs/mainnet/l2reth-genesis.json.

L2RETH_L1_ENDPOINT=http://l1-interface:8545

# Provided at onboarding: the P2P network id of the mainnet nodes.
L2RETH_NETWORK_ID=

# Provided at onboarding: the DA blob archive URL.
L2RETH_BLOB_S3_URL=

# Provided at onboarding: bootnode and sequencer enodes, as a JSON list like
# the testnet L2GETH_PEER_LIST.
L2RETH_PEER_LIST=

# Optional, provided at onboarding: the sequencer RPC URL. With it, the node
# forwards eth_sendRawTransaction to the sequencer (--network.sequencer-url).
L2RETH_SEQUENCER_URL=

# Matches numL1MessagesPerBlock in the mainnet genesis.
L2RETH_MAX_L1_MESSAGES=10

# The legacy geth header transform is only for testnet's geth-to-Reth history.
L2RETH_LEGACY_GETH_HEADER_TRANSFORM=false

# --gpo.maxprice must be at least the 420,000 DOGE-gwei base fee cap so
# eth_maxPriorityFeePerGas is not capped at reth's 500 gwei default.
L2RETH_GPO_MAXPRICE=420000000000000
