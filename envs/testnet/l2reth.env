# Testnet peer list

# L2Reth reads DA blobs directly from the public archive.
L2RETH_BLOB_S3_URL=https://dogeos-eth-da-archive-testnet.s3.us-west-2.amazonaws.com/rehearsal/batches

L2RETH_VALID_SIGNER=0xc91396C888e02BE45d4716EfDeD4252966855635
L2RETH_L1_ENDPOINT=http://l1-interface:8545
# NOTE: Placeholder or cluster-local peer domains need to be replaced with public p2p endpoints
# Run: kubectl get svc -n default | grep p2p
# Replace unresolved peer hosts with actual EXTERNAL-IP domains
L2GETH_PEER_LIST=["enode://90b1d52f52cfd40d9431594601393da6dd083d3ea133d2cecb0e9788371c753f6893512033a8854cd0f11a15df014d6d63007d3381c442d124994becef5fdf04@dogeos-testnet-cluster-b-reth-0-584e0f353e3e1570.elb.us-east-1.amazonaws.com:30303","enode://af14dff4906df5b0de6182237aca4b244ae8356e7210ed73374a61cce13b838cb99633b7060386fec1e6ec33c54d8bf349b5b8ae34d976ab8c447e37e5a0c0d6@dogeos-testnet-cluster-b-reth-1-2c89a90b165b427c.elb.us-east-1.amazonaws.com:30303"]

# P2P network id — must match the cluster nodes (see l2-reth-rpc-production.yaml networkId)
L2RETH_NETWORK_ID=4444444
