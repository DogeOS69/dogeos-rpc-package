# Network Selection
# This release supports the complete RPC stack on testnet only.
# Do not start the full stack with this mainnet template.
# Do not overwrite an existing env.
NETWORK=mainnet

# Docker Compose Project Name
# Used to isolate containers and networks when multiple environments run on one host.
COMPOSE_PROJECT_NAME=dogeos-rpc-package-mainnet

# Persistent Data Directory (Dogecoin, L2Reth, and L1 Interface data)
# REQUIRED: replace this placeholder with an absolute path on this host's data disk.
# /path/to/... is a placeholder, not a usable default. Edit it before any commands.
# Choose a separate path from any testnet deployment and verify the disk is mounted.
# Do not put chain data under this repository.
DATA_ROOT=/path/to/dogeos-data/mainnet

# Dogecoin Data Directory
# Mainnet stores Dogecoin data under DATA_ROOT, like L2Reth and L1 Interface.
# Keep this an absolute path; a bare name would select a Docker named volume.
DOGECOIN_DATA=${DATA_ROOT}/dogecoin

# Dogecoin RPC Credentials
# REQUIRED: set a strong password before the first start; Dogecoin refuses to
# start while it is empty. Keep the values stable afterwards. Compose mounts the
# same values as secrets into both dogecoin-node and l1-interface. They are never
# generated or changed automatically. Supported characters are letters, digits,
# and ._~:@%+=,-
DOGECOIN_RPC_USER=doge
DOGECOIN_RPC_PASSWORD=

# Dogecoin Ports
DOGECOIN_P2P_PORT=22556
DOGECOIN_RPC_PORT=22555

# L2Reth Ports
# These defaults avoid conflicts with testnet when both run on one host.
L2_HTTP_PORT=18545
L2_WS_PORT=18546
L2_P2P_PORT=40303

# Internal RPC Ports
# Dogecoin RPC and L1 Interface ports (8547, 5052, 9090) are only needed by this
# stack and local checks, so they are published on 127.0.0.1 only.
INTERNAL_BIND_ADDR=127.0.0.1

# L2Reth RPC (optional - uncomment to override)
# debug and trace are enabled by default. Filter and rate-limit them in your
# RPC gateway; trace calls are memory- and CPU-intensive.
# L2RETH_HTTP_API=eth,net,web3,debug,trace
# L2RETH_WS_API=eth,net,web3,debug,trace
# Extra rollup-node flags, separated by spaces. Do not repeat flags that
# scripts/l2reth_entrypoint.sh already sets (for example --rpc.max-connections).
# L2RETH_EXTRA_ARGS=--rpc.max-tracing-requests 8

# L2Reth Prometheus metrics, published on 127.0.0.1 only.
# L2_METRICS_PORT=6060

# Container log rotation (json-file driver).
# LOG_MAX_SIZE=100m
# LOG_MAX_FILE=5

# Dogecoin Memory Reservation
DOGECOIN_MEM_RESERVATION=14g

# Memory Limits (optional - uncomment to override defaults in docker-compose.yml)
# Adjust based on your host memory and expected RPC traffic.
# DOGECOIN_MEM_LIMIT=24g
# L2RETH_MEM_LIMIT=8g
# L1_INTERFACE_MEM_LIMIT=2g
