# Network Selection
# The full mainnet stack is NOT runnable from the tracked files in this release.
# This template is retained primarily to preserve the existing named Dogecoin
# volume during upgrades. Full mainnet enablement requires generating:
# - envs/mainnet/l2reth.env
# - configs/mainnet/l2reth-genesis.json
# - configs/mainnet/protocol_context.json
# and supplying mainnet-specific L1 Interface bootstrap artifacts in Compose.
# Running the bundled mainnet Dogecoin service also requires the Git-ignored
# Docker Secrets created by scripts/prepare-data-dir.sh.
NETWORK=mainnet

# Docker Compose Project Name
# Used to isolate containers and networks when multiple environments run on one host.
COMPOSE_PROJECT_NAME=dogeos-mainnet

# Persistent Data Directory (L2Reth and L1 Interface data)
# Use a dedicated data disk path. Do not put chain data under this repository.
DATA_ROOT=/mnt/wsl/data/dogeos-data/mainnet

# Dogecoin Docker Volume
# Dogecoin data stays in a named Docker volume so nodes upgraded from earlier
# releases keep their chain data without a resync. The default matches the
# volume name created by pre-v0.3.0 releases (COMPOSE_PROJECT_NAME was
# "dogeos-rpc-package-mainnet" on mainnet). If you used a custom
# COMPOSE_PROJECT_NAME before, set this to "<your-old-project-name>_dogecoin_data".
# Check with: docker volume ls | grep dogecoin_data
DOGECOIN_VOLUME_NAME=dogeos-rpc-package-mainnet_dogecoin_data

# Dogecoin Ports
DOGECOIN_P2P_PORT=22556
DOGECOIN_RPC_PORT=22555

# L2Reth Ports
# These defaults avoid conflicts with testnet when both run on one host.
L2_HTTP_PORT=18545
L2_WS_PORT=18546
L2_P2P_PORT=40303

# Dogecoin Memory Reservation
DOGECOIN_MEM_RESERVATION=14g

# Memory Limits (optional - uncomment to override defaults in docker-compose.yml)
# Adjust based on your host memory and expected RPC traffic.
# DOGECOIN_MEM_LIMIT=20g
# L2RETH_MEM_LIMIT=8g
# L1_INTERFACE_MEM_LIMIT=2g
