# Network Selection
# Mainnet is private. Do not start this stack until you have filled in the
# values you receive at operator onboarding; see "Mainnet Follower" in README.md.
# Existing mainnet operators should keep their current configuration,
# RPC credentials, and Dogecoin data volume. Do not overwrite an existing env;
# add the new settings below to it instead.
NETWORK=mainnet

# Docker Compose Project Name
# Used to isolate containers and networks when multiple environments run on one host.
# Keep the pre-v0.3.0 default for upgrades. If your old deployment used a custom
# project name, keep that name here and its matching DOGECOIN_VOLUME_NAME below.
COMPOSE_PROJECT_NAME=dogeos-rpc-package-mainnet

# Persistent Data Directory (L2Reth and L1 Interface data)
# REQUIRED: replace this placeholder with an absolute path on this host's data disk.
# /path/to/... is a placeholder, not a usable default. Edit it before any commands.
# Choose a separate path from any testnet deployment and verify the disk is mounted.
# Do not put chain data under this repository.
DATA_ROOT=/path/to/dogeos-data/mainnet

# Dogecoin Docker Volume
# Dogecoin data stays in a named Docker volume so nodes upgraded from earlier
# releases keep their chain data without a resync. The default matches the
# volume name created by pre-v0.3.0 releases (COMPOSE_PROJECT_NAME was
# "dogeos-rpc-package-mainnet" on mainnet). If you used a custom
# COMPOSE_PROJECT_NAME before, set this to "<your-old-project-name>_dogecoin_data".
# Check with: docker volume ls | grep dogecoin_data
DOGECOIN_VOLUME_NAME=dogeos-rpc-package-mainnet_dogecoin_data

# Dogecoin RPC Credentials
# These compatibility defaults match the earlier mainnet package. Change them
# here once if desired and keep them stable. Compose mounts the same values as
# secrets into both dogecoin-node and l1-interface. They are never generated or
# changed automatically. Never expose the RPC port publicly with this password.
DOGECOIN_RPC_USER=doge
DOGECOIN_RPC_PASSWORD=secure_password_here

# Dogecoin Ports
DOGECOIN_P2P_PORT=22556
DOGECOIN_RPC_PORT=22555

# L2Reth Ports
# Mainnet defaults. They do not let mainnet run beside testnet: L1 Interface
# uses fixed host ports, so run one complete stack per host.
L2_HTTP_PORT=18545
L2_WS_PORT=18546
L2_P2P_PORT=40303

# Image Tags and Bootstrap Artifacts
# docker-compose.yml defaults these to the testnet release, so mainnet sets
# them here.
# L2Reth needs rollup-node v0.3.0-beta.2 or later on mainnet: earlier images
# do not support the mainnet genesis or its 420,000 DOGE-gwei base fee cap.
L2RETH_IMAGE_TAG=v0.3.0-beta.2
# Provided at onboarding: the L1 Interface image tag and the bootstrap download
# URLs (each URL's file name must end in -<sha256>). These placeholders fail to
# pull or download until you replace them.
L1_INTERFACE_IMAGE_TAG=provided-at-onboarding
L1_INTERFACE_ARTIFACT_URL=provided-at-onboarding
L1_INTERFACE_REPLAY_DB_URL=provided-at-onboarding

# Dogecoin Memory Reservation
DOGECOIN_MEM_RESERVATION=14g

# Memory Limits (optional - uncomment to override defaults in docker-compose.yml)
# Adjust based on your host memory and expected RPC traffic.
# DOGECOIN_MEM_LIMIT=24g
# L2RETH_MEM_LIMIT=8g
# L1_INTERFACE_MEM_LIMIT=2g
